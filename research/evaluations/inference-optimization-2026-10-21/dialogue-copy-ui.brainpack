{"format":"mobile-local-brainpack","sha256":"ff8a889df79812d299d626ced371cbdc88e29d51cf709d31c4622023c1a086bb","payload":{"schema":2,"createdAt":"2026-10-20T23:45:32.275Z","notes":[{"id":"builtin-package-math.calculate/SKILL.md","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"SKILL.md","body":"# math.calculate\nCompute explicit arithmetic locally. Input: {\"expression\":\"(1200 + 800) / 4\"}.\nSupports decimal/scientific numbers, parentheses, unary signs, + - * / × ÷.\nUses finite IEEE-754 binary64 arithmetic, not exact financial decimal arithmetic.\nNo JavaScript evaluation, variables, units, percentages, filesystem or network access.\nReject invalid expressions, division by zero, excessive nesting and nonfinite results.\nResults and the exact expression are retained in the normal activity record; no automatic note writes.\n","path":"Tools/math.calculate/SKILL.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-package-math.calculate/tool.ts","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"tool.ts","body":"import type {ToolHost} from '../tool-host.ts';\nexport const definition=Object.freeze({id:'math.calculate',version:1,readOnly:true,network:'none'});\n// Only whole, explicit arithmetic inputs bypass planning. No document or history scan.\nexport function calculatorInput(text:string):string|null {\n if(/^\\d{4}-\\d{2}-\\d{2}$/.test(text.trim()))return null;\n const value=text.trim().replace(/^calc(?:ulate)?\\s*:\\s*/i,'').replace(/＝/g,'=').replace(/=\\s*$/,'').trim();\n return value && /^[\\d\\s.+\\-*/()×÷−eE]+$/.test(value) && /\\d/.test(value) && /[+*/×÷]|\\d\\s*[-−]/.test(value)?value:null;\n}\nexport function calculate(expression:string):number {\n if(typeof expression!=='string'||!expression.trim()||expression.length>1000)throw Error('Invalid calculation');\n const source=expression.replace(/×/g,'*').replace(/÷/g,'/').replace(/−/g,'-');let pos=0,depth=0;\n const space=()=>{while(/\\s/.test(source[pos]??'')&&pos<source.length)pos++;};\n const finite=(n:number)=>{if(!Number.isFinite(n))throw Error('Calculation out of range');return n;};\n function atom():number {space();if(++depth>32)throw Error('Calculation nesting limit');let n:number;\n  const c=source[pos];if(c==='+'||c==='-'){pos++;n=(c==='-'?-1:1)*atom();}\n  else if(c==='('){pos++;n=sum();space();if(source[pos++]!==')')throw Error('Invalid calculation');}\n  else {const match=source.slice(pos).match(/^(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?/);if(!match)throw Error('Invalid calculation');pos+=match[0].length;n=Number(match[0]);}\n  depth--;return finite(n);\n }\n function product():number {let n=atom();space();while(source[pos]==='*'||source[pos]==='/'){const op=source[pos++],rhs=atom();if(op==='/'&&rhs===0)throw Error('Cannot divide by zero');n=finite(op==='*'?n*rhs:n/rhs);space();}return n;}\n function sum():number {let n=product();space();while(source[pos]==='+'||source[pos]==='-'){const op=source[pos++],rhs=product();n=finite(op==='+'?n+rhs:n-rhs);space();}return n;}\n const result=sum();space();if(pos!==source.length)throw Error('Invalid calculation');return Object.is(result,-0)?0:result;\n}\nexport async function run(args:unknown,host:ToolHost){\n if(!args||typeof args!=='object'||Array.isArray(args)||Object.keys(args).length!==1||!Object.hasOwn(args,'expression'))throw Error('Invalid tool arguments');\n host.check();const expression=(args as {expression:string}).expression,result=calculate(expression);host.check();\n return [{expression,result,precision:'IEEE-754 binary64'}];\n}\n// A whole-request finite grammar, not a scan of arbitrary prose or a repair of\n// model output. Each explicit \"then\" folds the previous result as one operand.\nexport function orderedCalculationInput(text:string):string|null {\n if(text.length>1000)return null;\n const clauses=text.trim().replace(/[.!?]$/,'').split(/\\s*,?\\s+then\\s+/i);if(clauses.length>16)return null;\n const number='[+−-]?(?:\\\\d+(?:\\\\.\\\\d*)?|\\\\.\\\\d+)(?:[eE][+-]?\\\\d+)?',numeric=new RegExp('^'+number+'$');\n const first=clauses[0].trim();let expression:string|null=null;\n const total=first.match(/^(?:calculate\\s+(?:the\\s+)?(?:sum|total)\\s+of|add)\\s+(.+)$/i);\n if(total){const terms=total[1].split(/\\s+and\\s+/i);if(terms.length<2||terms.length>16||terms.some(term=>!numeric.test(term)))return null;expression='('+terms.join(' + ')+')';}\n else {\n  const binary=first.match(new RegExp('^(subtract|multiply|divide)\\\\s+('+number+')\\\\s+(from|by)\\\\s+('+number+')$','i'));\n  if(binary){const [,verb,left,link,right]=binary;if(verb.toLowerCase()==='subtract'){if(link.toLowerCase()!=='from')return null;expression='('+right+' - '+left+')';}else{if(link.toLowerCase()!=='by')return null;expression='('+left+(verb.toLowerCase()==='multiply'?' * ':' / ')+right+')';}}\n  else {const calculation=first.match(/^calculate\\s+(.+)$/i);if(!calculation)return null;expression=calculatorInput(calculation[1])??(numeric.test(calculation[1])?calculation[1]:null);}\n }\n if(expression===null)return null;\n for(const clause of clauses.slice(1)){const step=clause.trim().match(new RegExp('^(add|subtract|multiply by|divide by)\\\\s+('+number+')$','i'));if(!step)return null;const op=({'add':'+','subtract':'-','multiply by':'*','divide by':'/'} as Record<string,string>)[step[1].toLowerCase()];expression='('+expression+' '+op+' '+step[2]+')';}\n return expression;\n}\n","path":"Tools/math.calculate/tool.ts","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-package-memory.read/SKILL.md","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"SKILL.md","body":"# memory.read\n\nUse for explicit local saved-record reading by exact ID, path or filename. Resolve exact IDs first, then full paths, then filenames. A filename shared by multiple records returns all matches; do not select the first arbitrarily.\n\nInput: `{query: string}`. Execution uses the current canonical host snapshot. Results retain IDs and revisions. No writes, network, installation or permission changes. Guidance is not execution authority.\n","path":"Tools/memory.read/SKILL.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-package-memory.read/tool.ts","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"tool.ts","body":"import { validateQuery, type ToolHost } from '../tool-host.ts';\nexport const definition = Object.freeze({id: 'memory.read', version: 2, readOnly: true, network: 'none', inputSchema: {type: 'object', required: ['query'], additionalProperties: false, properties: {query: {type: 'string', minLength: 1, maxLength: 2000}}}});\nexport async function run(args: unknown, host: ToolHost) {\n const query = validateQuery(args);\n host.check();\n const notes = await host.views();\n const byId = notes.filter(n => n.id === query);\n const byPath = byId.length ? [] : notes.filter(n => n.path === query);\n const result = byId.length ? byId : byPath.length ? byPath : notes.filter(n => n.path.split('/').at(-1) === query);\n host.check();\n return result;\n}\n","path":"Tools/memory.read/tool.ts","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-package-memory.search/SKILL.md","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"SKILL.md","body":"# memory.search\n\nUse for explicit local saved-record search.\n\nInput: `{query: string}`. Execution uses the current canonical host snapshot. Results retain IDs and revisions. No writes, network, installation or permission changes. Guidance is not execution authority.\n","path":"Tools/memory.search/SKILL.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-package-memory.search/tool.ts","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"tool.ts","body":"import { validateQuery, type ToolHost } from '../tool-host.ts';\nexport const definition = Object.freeze({id: 'memory.search', version: 1, readOnly: true, network: 'none', inputSchema: {type: 'object', required: ['query'], additionalProperties: false, properties: {query: {type: 'string', minLength: 1, maxLength: 2000}}}});\nexport async function run(args: unknown, host: ToolHost) {\n const query = validateQuery(args);\n host.check();\n const result = await host.search(query);\n host.check();\n return result;\n}\n","path":"Tools/memory.search/tool.ts","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-package-tool-host.ts","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"tool-host.ts","body":"export interface ToolNote {id:string;path:string;version:number;body:string;[key:string]:any}\nexport interface ToolHost {search(query:string):Promise<any[]>;views():Promise<ToolNote[]>;check():void}\nexport function validateQuery(args:unknown):string {\n if(!args || typeof args!=='object' || Array.isArray(args) || Object.keys(args).length!==1 || !Object.hasOwn(args,'query'))throw new Error('Invalid tool arguments');\n const query=(args as {query:unknown}).query;\n if(typeof query!=='string'||!query.trim()||query.length>2000)throw new Error('Invalid tool query');\n return query;\n}\n","path":"Tools/tool-host.ts","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-tools-README","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.774Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"README.md","body":"# Tools\n\nLocal adapters are connected for saved-record search/read, reviewed capture and ordinary-note corrections. Model assistance requires a prepared local Text model.\n\nCapture opens a new-note review. Corrections show complete Before/After; explicit Save alone writes the approved change. History retains revisions and offers eligible Undo.\n\nExternal/custom definitions do not execute code or connect to services. Adding Markdown does not install an adapter or grant permissions. mcp.example remains a disabled template. Credentials do not belong in Markdown, backups or model context.\n\nReviewed schedule.patch edits existing local-zone task conditions/prompt; schedule.propose opens a paused new-task review. Reviewed settings.patch changes appearance or already registered model selections/languages. These use the same expected-record checks, history and eligible Undo; they cannot change execution permissions, model libraries or network access.","path":"Tools/README.md","at":"2026-10-20T23:39:17.774Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-tools-mcp.example","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"mcp.example.md","body":"---\nid: external.example\nkind: mcp\nenabled: false\nendpoint: null\nallowed_tools: []\n---\n\nTemplate only. Configure a destination and review what data each tool sends before enabling. No connection is made by creating or editing this file. Credentials must not be stored in Markdown, backups or model context.","path":"Tools/mcp.example.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-tools-memory.capture","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"memory.capture.md","body":"---\nid: memory.capture\nkind: builtin\noperation: propose_create\nnetwork: none\ndefault_folder: Inbox\n---\n\nOpen a new-note review from an explicit capture request. Only explicit Save creates a record with a new ID. Preserve the exact approved content; saving an existing generated answer does not regenerate it.","path":"Tools/memory.capture.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-tools-memory.patch","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"memory.patch.md","body":"---\nid: memory.patch\nkind: builtin\noperation: propose_patch\nnetwork: none\n---\n\nPropose literal replacement, line splitting or a semantic body rewrite of one identified ordinary note. Show the exact target/version and complete Before/After. Explicit Save checks the expected record and appends a revision and receipt; eligible Undo appends another revision. A changed target refuses approval. System records use separate finite operations: schedule.patch supports prompt/conditions/notify on eligible local-zone tasks, never enabled or timezone; settings.patch supports appearance and already registered model selections/languages, never libraries, downloads, readiness or permissions. Generic system rewrites and Tools/log edits remain unavailable. Document/model text never grants overwrite, delete or network authority.","path":"Tools/memory.patch.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-tools-memory.read","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"memory.read.md","body":"---\nid: memory.read\nkind: builtin\noperation: read\nnetwork: none\n---\n\nRead an identified local record and revision. Missing or withdrawn sources must not be presented as current evidence.","path":"Tools/memory.read.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"builtin-tools-memory.search","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"memory.search.md","body":"---\nid: memory.search\nkind: builtin\noperation: read\nnetwork: none\n---\n\nSearch local saved records. Return record IDs, exact revisions and source ranges.","path":"Tools/memory.search.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}},{"id":"d718d5f7-eefc-4c1d-bb04-99af08a5f5be","kind":"generated","state":"active","createdAt":"2026-10-20T23:42:38.651Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"Answer-2026-10-21","body":"QA first assistant answer\r\n日本語 🌳","path":"Inbox/Answer-2026-10-21.md","at":"2026-10-20T23:42:38.651Z"}],"dialogueCopy":{"schema":1,"noteRevision":1,"turnId":"qa-copy-first","turnIndex":0,"speaker":"assistant","quote":"QA first assistant answer\r\n日本語 🌳","refs":[],"edited":false}},{"id":"settings-appearance","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"appearance.md","body":"# Appearance\n\n```json\n{\n  \"theme\": \"system\",\n  \"background\": \"paper\",\n  \"glass\": \"clear\"\n}\n```\n","path":"Settings/appearance.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":false,"managed":true}},{"id":"settings-connection","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"connection.md","body":"# Connection\n\n```json\n{\n  \"downloads\": false,\n  \"diagnosticLogs\": false\n}\n```\n","path":"Settings/connection.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":false,"managed":true}},{"id":"settings-models","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"models.md","body":"# Models\n\n```json\n{\n  \"customModels\": [],\n  \"customDecisionModels\": [],\n  \"customSpeechModels\": [],\n  \"visionModel\": \"\",\n  \"visionLibrary\": [],\n  \"ocrModel\": \"\",\n  \"ocrLibrary\": [],\n  \"ocrLanguage\": \"eng+jpn\",\n  \"transcriptionLanguage\": \"en\",\n  \"textLibrary\": [\n    \"4B\",\n    \"2B\",\n    \"lfm25-230m-qad-q4-0\"\n  ],\n  \"decisionLibrary\": [],\n  \"textModel\": \"4B\",\n  \"decisionModel\": \"\",\n  \"transcriptionModel\": \"\",\n  \"transcriptionLibrary\": []\n}\n```\n","path":"Settings/models.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":false,"managed":true}},{"id":"settings-readme","kind":"original","state":"active","createdAt":"2026-10-20T23:39:17.775Z","aliases":[],"sources":[],"revisions":[{"version":1,"title":"README.md","body":"# Settings\n\nThese records are shared with the Settings screen. Edit values in the JSON block; invalid changes are not applied.\n\nModel readiness and execution permissions are managed by the application. Do not store credentials here.\n\nPreview state is session-only.","path":"Settings/README.md","at":"2026-10-20T23:39:17.775Z"}],"ui":{"protected":true,"managed":false}}],"settings":[{"key":"ui-v1-dialogue","value":{"schema":1,"revision":3,"turns":[{"id":"qa-copy-first","user":"QA first human message","answer":"QA first assistant answer\r\n日本語 🌳"},{"id":"qa-copy-last","user":"QA latest human message","answer":"QA latest assistant answer"}],"compaction":null,"currentFile":{"noteId":"d718d5f7-eefc-4c1d-bb04-99af08a5f5be","revision":1}}}],"runs":[],"undefinedPaths":[],"excluded":["model-assets","runtime-assets","unsaved-drafts","unpersisted-attachments"]}}