+        while (slot.prompt.checkpoints.size() >= (size_t) params_base.n_ctx_checkpoints) {
+            // Preserve an early anchor and spread the bounded checkpoints over
+            // the prefix. FIFO eviction loses every early tool-schema boundary
+            // in a long prompt and forces recurrent models to start from zero.
+            // Remove the point whose neighbours are closest, including the
+            // incoming checkpoint as the right neighbour of the last point.
+            auto victim = slot.prompt.checkpoints.begin();
+            int64_t smallest_span = INT64_MAX;
+            for (auto it = std::next(slot.prompt.checkpoints.begin()); it != slot.prompt.checkpoints.end(); ++it) {
+                const auto right = std::next(it);
+                const int64_t next = right != slot.prompt.checkpoints.end()
+                    ? right->n_tokens
+                    : slot.prompt.n_tokens() - n_tokens_cur;
+                const int64_t span = next - std::prev(it)->n_tokens;
+                // At equal spacing keep the earlier, more widely shared prefix.
+                if (span <= smallest_span) {
+                    smallest_span = span;
+                    victim = it;
+                }
+            }
+            SLT_TRC(slot, "erasing crowded context checkpoint (pos_min = %d, pos_max = %d, n_tokens = %" PRId64 ", size = %.3f MiB)\n",
+                    victim->pos_min, victim->pos_max, victim->n_tokens, (float) victim->size() / 1024 / 1024);
