{
  "name": "design-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:editor:built": "playwright test -c playwright.editor.config.ts",
    "test:help:built": "playwright test -c playwright.help.config.ts",
    "test:ios-handoff": "npm run build:app --prefix ../.. && npm run test:ios-handoff:built && npm run test:ios-handoff:webkit:built",
    "test:ios-handoff:built": "playwright test -c playwright.device.config.ts",
    "test:ios-handoff:webkit:built": "playwright test -c playwright.device.config.ts --browser=webkit --workers=1",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime && node scripts/prepare-ocr-runtime.mjs && node scripts/prepare-license-notices.mjs",
    "dev": "vite",
    "prebuild": "npm run check:runtime && node scripts/prepare-ocr-runtime.mjs && node scripts/prepare-license-notices.mjs",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "test:tools:built": "playwright test -c playwright.tools.config.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@huggingface/transformers": "4.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "@wllama/wllama": "3.8.1",
    "@wllama/wllama-compat": "3.8.1",
    "hash-wasm": "4.12.0",
    "mediabunny": "1.61.6",
    "motion": "12.42.2",
    "onnxruntime-web-d1": "npm:onnxruntime-web@1.31.0-dev.20260914-8d85527a0",
    "pdfjs-dist": "6.4.299",
    "quickjs-emscripten": "0.32.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
