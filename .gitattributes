# Protected runtime hashes must survive a Windows checkout unchanged.
design/prototype/** text eol=lf
design/prototype/**/*.png binary
design/prototype/licenses/*.tar.gz binary
docs/design/*.png binary
# Baseline shell hashes must also be stable after checkout.
dist/** text eol=lf
dist/*.png binary
# Diagnostic raw prompts/stdout include meaningful exact LF/CRLF and terminal blanks.
research/evaluations/reference-cpu-e3de715/** -text whitespace=-blank-at-eof,-blank-at-eol

# Preserve byte-pinned source patch and upstream license on Windows.
research/runtime/wllama-count/count.patch -text
research/runtime/wllama-count/UPSTREAM-LICENCE -text

# Preserve pinned generated runtime JS byte identity.
design/prototype/runtime/wllama-count/*.js -text
design/prototype/runtime/wllama-count/*.wasm binary
